# Google Gemini / Gemma API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Multimodal Model Identifier
# Default supported Gemma 4 model for multimodal reasoning & function calling:
GEMMA_MODEL=gemma-4-26b-a4b-it

# Host & Port settings
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database path (relative to backend or absolute)
DATABASE_URL=../data/fixit.db
